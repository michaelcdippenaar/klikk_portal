# Existing production backend. Do not add credentials to this file.
KLIKK_BACKEND_ORIGIN=https://console.8-bit.space

# Absolute path on the Docker host. Use a public *.pub file or an
# authorized_keys file. Never point this setting at a private key.
KLIKK_DEV_PUBLIC_KEY=/home/replace-me/.ssh/id_ed25519.pub

KLIKK_DEV_HTTP_BIND=127.0.0.1
KLIKK_DEV_HTTP_PORT=4173
KLIKK_DEV_SSH_BIND=127.0.0.1
KLIKK_DEV_SSH_PORT=2222
